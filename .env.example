# Copy to .env.local (or .env) and fill in. .env.local is read first; both are gitignored.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# TigerData connection string for YOUR fork: tiger db uri <service-id> --with-password
# Append &uselibpqcompat=true: Tiger signs with its own CA, which pg rejects under sslmode=require.
DATABASE_URL=
# Optional: only if Klair can't find graphify (it checks ~/.local/bin, /opt/homebrew/bin and your shell PATH)
GRAPHIFY_BIN=
# Optional: separate OpenRouter key for Graphify, so indexing cost shows up on its own
GRAPHIFY_OPENROUTER_KEY=
# Optional: model Graphify uses for extraction
GRAPHIFY_MODEL=anthropic/claude-haiku-5.5

# Models (must accept images). CLAIRE_* names still work as a fallback.
KLAIR_FAST_MODEL=google/gemini-3.5-flash-lite
KLAIR_ANSWER_MODEL=openai/gpt-5.4-mini
# Judges whether a changed screen is really new content, and whether a screen belongs in the
# session's context ("off" to skip both)
KLAIR_CHANGE_MODEL=typesafe/jev-router

# Timing (milliseconds)
KLAIR_CAPTURE_MS=4000
KLAIR_DWELL_MS=60000
KLAIR_COOLDOWN_MS=120000
# How long sessions are kept, in days (TigerData retention policy + local cleanup)
KLAIR_RETENTION_DAYS=14

# Optional features
# applescript = read front app, window title and browser URL (asks for Automation permission)
KLAIR_ACTIVE_WINDOW=
# full = send the whole session as context instead of retrieval (token baseline runs)
KLAIR_BASELINE=
# Fallback open/close key while the fn add-on isn't available
KLAIR_TOGGLE_KEY=Control+Alt+K

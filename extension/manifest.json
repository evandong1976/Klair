{
  "manifest_version": 3,
  "name": "Klair for Chrome",
  "version": "0.2.0",
  "description": "Sends the full text of the pages you open to the Klair app on this Mac while a Klair session is running, and marks the passages Klair's answers are about.",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["highlight.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Klair",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "incognito": "not_allowed"
}
